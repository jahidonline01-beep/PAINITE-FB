<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2F5">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:background="@drawable/bg_toolbar_gradient"
        android:elevation="8dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:id="@+id/imgLogo"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <!-- P (blue on red) + AINIT white + E (blue on red) + FB colorful -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="P"
            android:textColor="#FF4D4D"
            android:textStyle="bold"
            android:textSize="17sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AINIT"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="17sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="E"
            android:textColor="#FF4D4D"
            android:textStyle="bold"
            android:textSize="17sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:text=" FB"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="17sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="PRO"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:background="@drawable/bg_pro_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDesktop"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:minWidth="36dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="📱"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:backgroundTint="@android:color/transparent"
            android:contentDescription="Desktop or Mobile mode"
            app:cornerRadius="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTheme"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:minWidth="36dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="🌙"
            android:textSize="15sp"
            android:backgroundTint="@android:color/transparent"
            android:contentDescription="Theme"
            app:cornerRadius="18dp" />
        <ImageButton
            android:id="@+id/btnTelegram"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_telegram"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Telegram"
            android:padding="10dp" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/navScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#FDECEC"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:elevation="4dp">
        <LinearLayout
            android:id="@+id/navChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/progressFb"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/contentHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- HOME -->
        <ScrollView
            android:id="@+id/panelHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="28dp">
                <View android:layout_width="1dp" android:layout_height="48dp" />
                <TextView
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:gravity="center"
                    android:text="f"
                    android:textSize="46sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_fb_circle"
                    android:elevation="6dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="facebook"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="#0866FF" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="28dp"
                    android:padding="20dp"
                    android:background="@drawable/bg_card_elevated"
                    android:elevation="6dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCreateAccount"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Create New Facebook Account"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        app:cornerRadius="16dp"
                        app:backgroundTint="#0866FF" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogin"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:text="Log In"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:textColor="#0866FF"
                        app:strokeColor="#0866FF"
                        app:strokeWidth="2dp"
                        app:cornerRadius="16dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Facebook WebView full area under nav -->
        <WebView
            android:id="@+id/webViewFb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:overScrollMode="never"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- Mail: zoom bar + WebView -->
        <LinearLayout
            android:id="@+id/panelMail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:background="#FFFFFF"
                android:elevation="2dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✉  Live"
                    android:textSize="12sp"
                    android:textColor="#059669"
                    android:textStyle="bold" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView
                    android:id="@+id/tvZoom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:layout_marginEnd="8dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnZoomOut"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:text="−"
                    android:textSize="18sp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnZoomIn"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:text="+"
                    android:textSize="18sp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMailReload"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:text="↻"
                    android:textSize="16sp" />
            </LinearLayout>
            <WebView
                android:id="@+id/webViewMail"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:overScrollMode="never" />
        </LinearLayout>

        <!-- USA -->
        <ScrollView
            android:id="@+id/panelUsa"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="16dp"
            android:background="#F0F2F5">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_elevated"
                android:padding="18dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:background="#EDE4FF"
                    android:padding="5dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFemale"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Female"
                        android:textSize="15sp"
                        android:textAllCaps="false"
                        android:maxLines="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:elevation="0dp"
                        android:stateListAnimator="@null"
                        app:cornerRadius="12dp"
                        app:strokeWidth="0dp"
                        app:backgroundTint="#7C3AED"
                        android:textColor="#FFFFFF" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMale"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Male"
                        android:textSize="15sp"
                        android:textAllCaps="false"
                        android:maxLines="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:elevation="0dp"
                        android:stateListAnimator="@null"
                        app:cornerRadius="12dp"
                        app:strokeWidth="0dp"
                        app:backgroundTint="#EDE4FF"
                        android:textColor="#6B21A8" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="FULL USA NAME"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#7C3AED" />
                <TextView
                    android:id="@+id/tvFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#1E1B4B"
                    android:layout_marginTop="4dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyFull"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Copy Full Name"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    app:backgroundTint="#7C3AED"
                    app:cornerRadius="12dp"
                    android:layout_marginTop="10dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:background="#F5F3FF"
                        android:layout_marginEnd="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="FIRST" android:textSize="11sp" android:textStyle="bold" android:textColor="#7C3AED" />
                        <TextView android:id="@+id/tvFirst" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:text="—" android:textStyle="bold"
                            android:textSize="18sp" android:textColor="#1E1B4B" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyFirst"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content" android:layout_height="40dp"
                            android:text="COPY" android:textSize="13sp" android:textColor="#7C3AED" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:background="#F5F3FF">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="SURNAME" android:textSize="11sp" android:textStyle="bold" android:textColor="#7C3AED" />
                        <TextView android:id="@+id/tvLast" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:text="—" android:textStyle="bold"
                            android:textSize="18sp" android:textColor="#1E1B4B" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyLast"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content" android:layout_height="40dp"
                            android:text="COPY" android:textSize="13sp" android:textColor="#7C3AED" />
                    </LinearLayout>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGenUsa"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:text="Generate USA Name"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    app:backgroundTint="#7C3AED"
                    app:cornerRadius="16dp" />
            </LinearLayout>
        </ScrollView>

        <!-- ADD FD -->
        <ScrollView
            android:id="@+id/panelAddFd"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="14dp"
            android:background="#F0F2F5">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_card_elevated"
                    android:padding="4dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tabAll"
                        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:text="All" android:textSize="13sp" android:textAllCaps="false"
                        app:cornerRadius="12dp" app:backgroundTint="#0866FF" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tabOfficial"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:text="Official" android:textSize="13sp" android:textAllCaps="false" android:textColor="#334155" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tabCeleb"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:text="Celebs" android:textSize="13sp" android:textAllCaps="false" android:textColor="#334155" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/addFdList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </ScrollView>

        <!-- 2FA -->
        <ScrollView
            android:id="@+id/panel2fa"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="16dp"
            android:background="#F0F2F5">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_elevated"
                android:padding="18dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Paste 2FA Secret Key"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical">
                    <EditText
                        android:id="@+id/etSecret"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:hint="E.G. 46GF 5HX3 2K9P"
                        android:inputType="text"
                        android:padding="14dp"
                        android:background="#FFF7ED"
                        android:textSize="14sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearSecret"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:text="Clear"
                        android:textAllCaps="false"
                        app:backgroundTint="#EF4444"
                        app:cornerRadius="12dp"
                        android:layout_marginStart="10dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    android:padding="22dp"
                    android:background="@drawable/bg_2fa_card"
                    android:gravity="center_horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACTIVE 2FA CODE"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvCode"
                        android:textIsSelectable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="— — — — — —"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:letterSpacing="0.15"
                        android:layout_marginTop="12dp"
                        android:padding="12dp"
                        android:background="#33000000" />
                    <TextView
                        android:id="@+id/tvTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Refreshes in: 30s"
                        android:textColor="#FFFFFF"
                        android:layout_marginTop="10dp" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyCode"
                    android:minHeight="56dp"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="16dp"
                    android:text="Copy 2FA Code"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    app:backgroundTint="#F59E0B"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </ScrollView>

        <!-- Cookies -->
        <ScrollView
            android:id="@+id/panelCookies"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="16dp"
            android:background="#F0F2F5">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_elevated"
                android:padding="18dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FACEBOOK UID"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#0866FF" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:id="@+id/tvUid"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="N/A"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyUid"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="Copy UID"
                        android:textAllCaps="false"
                        app:cornerRadius="12dp" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Import Cookies"
                    android:textStyle="bold"
                    android:textSize="14sp" />
                <EditText
                    android:id="@+id/etCookies"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="8dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:padding="14dp"
                    android:background="#F1F5F9"
                    android:hint="datr=...; c_user=...; xs=...;" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplyCookies"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:text="Save &amp; Apply Cookies"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    app:backgroundTint="#0866FF"
                    app:cornerRadius="14dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Active Session"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyCookies"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Copy"
                        android:textAllCaps="false" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tvActiveCookies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="110dp"
                    android:background="#0F172A"
                    android:textColor="#64748B"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:padding="16dp"
                    android:textIsSelectable="true"
                    android:text="(Empty — no session)" />
            </LinearLayout>
        </ScrollView>

        <!-- Overlay WebView for Accounts Centre / external FB panels -->
        <LinearLayout
            android:id="@+id/panelOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#FFFFFF"
            android:elevation="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:background="#0866FF">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOverlayClose"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="← Back"
                    android:textColor="#FFFFFF"
                    android:textAllCaps="false" />
                <TextView
                    android:id="@+id/tvOverlayTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Accounts Centre"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </LinearLayout>
            <WebView
                android:id="@+id/webViewOverlay"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
