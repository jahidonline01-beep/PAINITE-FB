<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Page bg -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F0F2F5" />
        </shape>
    </item>
    <!-- Top toolbar strip -->
    <item android:top="0dp" android:bottom="0dp" android:height="48dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1D4ED8"
                android:endColor="#4F46E5"
                android:angle="0" />
        </shape>
    </item>
</layer-list>
