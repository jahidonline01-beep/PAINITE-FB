<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@drawable/bg_toolbar_gradient">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:contentDescription="Close" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cookies &amp; UID"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FACEBOOK UID"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/fb_blue" />

            <TextView
                android:id="@+id/tvUid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="N/A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyUid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Copy UID"
                app:backgroundTint="@color/fb_blue"
                app:cornerRadius="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Import / Paste Cookies"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etCookies"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:background="@android:color/white"
                android:padding="12dp"
                android:hint="datr=...; c_user=...; xs=...;" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplyCookies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save &amp; Open Facebook"
                android:layout_marginTop="8dp"
                app:backgroundTint="@color/fb_blue"
                app:cornerRadius="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Active Session Cookies"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvActiveCookies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:background="#0F172A"
                android:textColor="#34D399"
                android:fontFamily="monospace"
                android:textSize="10sp"
                android:padding="12dp"
                android:textIsSelectable="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyCookies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Copy Cookies"
                android:layout_marginTop="8dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearCookies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Clear All Cookies"
                android:layout_marginTop="8dp"
                android:textColor="#DC2626"
                style="@style/Widget.MaterialComponents.Button.TextButton" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
